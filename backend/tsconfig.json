{
  "compilerOptions": {
    "target": "es2022",                                  /* Versión de JavaScript a la que se va a traducir */
    "module": "CommonJS",                                /* Le dice a TS que traduzca los imports a require para que Node los entienda */
    "rootDir": "./src",                                  /* Carpeta donde está tu código fuente */
    "outDir": "./dist",                                  /* Carpeta donde se guardará el código compilado (cuando el proyecto esté listo) */
    "esModuleInterop": true,                             /* Fundamental: Permite que librerías antiguas funcionen bien con 'import' */
    "forceConsistentCasingInFileNames": true,            /* Evita errores por mayúsculas/minúsculas en los nombres de archivos */
    "strict": true,                                      /* Activa las validaciones estrictas (lo que hace que TS sea tan bueno) */
    "skipLibCheck": true                                 /* Acelera la compilación ignorando chequeos en la carpeta node_modules */
  },
  "include": ["src/**/*"]                                /* Le dice a TS que solo analice lo que está dentro de src */
}